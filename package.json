{
  "name": "firm",
  "version": "1.0.0",
  "private": true,
  "description": "Firm — Multi-Tenant Business Management Platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "build": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:studio": "cd backend && npm run prisma:studio",
    "db:generate": "cd database && npm run db:generate",
    "db:migrate": "cd database && npm run db:migrate",
    "db:seed": "cd database && npm run db:seed",
    "db:push": "cd database && npm run db:push",
    "db:reset": "cd database && npm run db:reset",
    "tunnel": "node scripts/cloudflare-tunnel.js",
    "dev:tunnel": "concurrently -n \"backend,frontend,tunnel\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"node scripts/cloudflare-tunnel.js\"",
    "start:tunnel": "concurrently -n \"backend,frontend,tunnel\" -c \"blue,green,magenta\" \"npm run start:backend\" \"npm run start:frontend\" \"node scripts/cloudflare-tunnel.js\"",
    "cap:build": "cd frontend && npm run cap:build",
    "cap:open": "cd frontend && npm run cap:open",
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../database && npm install",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
