# =============================================================================
# Firm Platform — Unified Production / VPS Environment Configuration
# =============================================================================
# Setup for Permanent Tailscale Funnel HTTPS Hostname:
# https://<my-vps-hostname>.<my-tailnet>.ts.net
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Public Domain / Base URL Configuration
# -----------------------------------------------------------------------------
# Set this to your permanent Tailscale Funnel HTTPS hostname.
# The application uses this to automatically derive both FRONTEND_URL and GOOGLE_REDIRECT_URI.
PUBLIC_URL=https://<my-vps-hostname>.<my-tailnet>.ts.net

# -----------------------------------------------------------------------------
# 2. Server Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# -----------------------------------------------------------------------------
# 3. Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/firm_db"

# -----------------------------------------------------------------------------
# 4. JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=your-production-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Google Cloud Console)
# -----------------------------------------------------------------------------
# Authorized JavaScript Origins to add in Google Cloud Console:
#   - http://localhost:3000 (Development)
#   - https://<my-vps-hostname>.<my-tailnet>.ts.net (Production Tailscale Funnel)
#
# Authorized Redirect URIs to add in Google Cloud Console:
#   - http://localhost:3000/callback (Development)
#   - https://<my-vps-hostname>.<my-tailnet>.ts.net/callback (Production Tailscale Funnel)

# Google Client ID (Public / shared with frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Client Secret (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Redirect URI (defaults to ${PUBLIC_URL}/callback if PUBLIC_URL is set)
GOOGLE_REDIRECT_URI=https://<my-vps-hostname>.<my-tailnet>.ts.net/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://<my-vps-hostname>.<my-tailnet>.ts.net/callback

# -----------------------------------------------------------------------------
# 6. Reverse Proxy & Frontend Routing
# -----------------------------------------------------------------------------
# Tailscale Funnel forwards external HTTPS traffic to local port 3000.
# Next.js on port 3000 automatically reverse-proxies /api/* requests to port 4000.
FRONTEND_URL=https://<my-vps-hostname>.<my-tailnet>.ts.net
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api

# -----------------------------------------------------------------------------
# 7. Super Admin & Security
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
