# Server Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL="postgresql://user:password@localhost:5432/firm_db"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Production Public URL (e.g. Tailscale Funnel HTTPS Hostname)
# -----------------------------------------------------------------------------
# In production on your VPS behind Tailscale Funnel, set PUBLIC_URL to your
# permanent HTTPS hostname. Setting this automatically sets the default
# FRONTEND_URL and GOOGLE_REDIRECT_URI (${PUBLIC_URL}/callback).
#
# Production (Tailscale Funnel):
# PUBLIC_URL=https://<my-vps-hostname>.<my-tailnet>.ts.net
#
# Local Development (leave empty or set to localhost):
# PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect URI:
# Must EXACTLY match the authorized redirect URI in Google Cloud Console.
# When PUBLIC_URL is set above, this automatically defaults to: ${PUBLIC_URL}/callback
# Development default: http://localhost:3000/callback
# Production (Tailscale Funnel): https://<my-vps-hostname>.<my-tailnet>.ts.net/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/callback

# Frontend URL (for CORS allowance and redirects):
# When PUBLIC_URL is set above, this automatically defaults to: ${PUBLIC_URL}
# Development default: http://localhost:3000
# Production (Tailscale Funnel): https://<my-vps-hostname>.<my-tailnet>.ts.net
FRONTEND_URL=http://localhost:3000

# Super Admin Bootstrap Email
SUPER_ADMIN_EMAIL=admin@example.com
