# -----------------------------------------------------------------------------
# Production Public URL (e.g. Tailscale Funnel HTTPS Hostname)
# -----------------------------------------------------------------------------
# In production on your VPS behind Tailscale Funnel, set PUBLIC_URL (or NEXT_PUBLIC_PUBLIC_URL)
# to your permanent HTTPS hostname.
#
# Production (Tailscale Funnel):
# NEXT_PUBLIC_PUBLIC_URL=https://<my-vps-hostname>.<my-tailnet>.ts.net
#
# Local Development (leave empty or set to localhost):
# NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Client Configuration
# -----------------------------------------------------------------------------
# NOTE: Only the Client ID is public. DO NOT put GOOGLE_CLIENT_SECRET in frontend .env!
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Redirect URI:
# Must EXACTLY match the authorized redirect URI configured in Google Cloud Console.
# When NEXT_PUBLIC_PUBLIC_URL or PUBLIC_URL is set, this automatically defaults to:
# ${NEXT_PUBLIC_PUBLIC_URL}/callback
#
# Development default: http://localhost:3000/callback
# Production (Tailscale Funnel): https://<my-vps-hostname>.<my-tailnet>.ts.net/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/callback

# -----------------------------------------------------------------------------
# Backend API URL
# -----------------------------------------------------------------------------
# In browsers, the app automatically proxies API calls through same-origin /api.
# This variable is used for mobile (Capacitor) or direct SSR fetch calls.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Internal backend URL used by Next.js rewrites to proxy /api/* requests (defaults to http://127.0.0.1:4000/api)
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api

# Super Admin email (for initial role routing)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@example.com

# Development mode - enables dev-login bypass for local UI development (disable in production)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
